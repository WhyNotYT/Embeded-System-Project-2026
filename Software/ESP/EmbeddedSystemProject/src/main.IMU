#include <Arduino.h>
#include <Wire.h>

#include <Adafruit_LSM6DS.h>
#include <Adafruit_LSM6DSO32.h>

#define IMU_SDA 48
#define IMU_SCL 45

TwoWire I2C_IMU = TwoWire(0);

Adafruit_LSM6DSO32 imu;

bool imu_ok = false;

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("================================");
    Serial.println("   ESP32-S3 LSM6DS IMU TEST");
    Serial.println("================================");

    Serial.printf("SDA: GPIO%d\n", IMU_SDA);
    Serial.printf("SCL: GPIO%d\n", IMU_SCL);

    // Start I2C
    I2C_IMU.begin(IMU_SDA, IMU_SCL, 100000);
    delay(100);

    // Your previous test found the device at 0x6A.
    Serial.println("Trying LSM6DSO32 at 0x6A...");

    imu_ok = imu.begin_I2C(0x6A, &I2C_IMU);

    if (!imu_ok)
    {
        Serial.println("FAILED: LSM6DSO32 not detected.");
        Serial.println("Trying 0x6B...");

        imu_ok = imu.begin_I2C(0x6B, &I2C_IMU);
    }

    if (!imu_ok)
    {
        Serial.println("FAILED: IMU not detected.");
        Serial.println("Check SDA/SCL, power and address.");
        return;
    }

    Serial.println("SUCCESS: LSM6DSO32 detected!");

    // IMPORTANT:
    // These enums are specific to LSM6DSO32.
    imu.setAccelRange(LSM6DSO32_ACCEL_RANGE_4_G);

    imu.setGyroRange(LSM6DS_GYRO_RANGE_250_DPS);

    imu.setAccelDataRate(LSM6DS_RATE_104_HZ);
    imu.setGyroDataRate(LSM6DS_RATE_104_HZ);

    Serial.println("Accelerometer: +/-4 G");
    Serial.println("Gyroscope:     +/-250 DPS");
    Serial.println("ODR:           104 Hz");
    Serial.println();

    delay(200);
}

void loop()
{
    if (!imu_ok)
    {
        delay(1000);
        return;
    }

    sensors_event_t accel;
    sensors_event_t gyro;
    sensors_event_t temp;

    imu.getEvent(&accel, &gyro, &temp);

    Serial.printf(
        "ACC  X:%+8.3f Y:%+8.3f Z:%+8.3f m/s2   "
        "GYRO X:%+8.3f Y:%+8.3f Z:%+8.3f rad/s   "
        "TEMP:%6.2f C\n",
        accel.acceleration.x,
        accel.acceleration.y,
        accel.acceleration.z,
        gyro.gyro.x,
        gyro.gyro.y,
        gyro.gyro.z,
        temp.temperature
    );

    delay(200);
}