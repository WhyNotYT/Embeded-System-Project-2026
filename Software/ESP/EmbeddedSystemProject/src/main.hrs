// ESP32-S3 Smart Watch — MAX30101 HRS bring-up
//
// HRS (MAX30101) -> hardware I2C bus 0 (PIN_HRS_SDA/SCL), 400 kHz.
// The MAX30101 supply is generated by a PWM-filtered rail on PIN_HRS_18V.
// PIN_HRS_INT is electrically tied to that rail, so we use it as an ADC
// monitor and continuously trim the PWM duty to hold approximately 1.90 V.

#include <Arduino.h>
#include <Wire.h>

// devxplained MAX3010x Sensor Library (works with MAX30101)
#include <MAX3010x.h>

#include "pins.h"

// ── HRS status ───────────────────────────────────────────────────────────────
static bool g_hrs_ok = false;

// ── HRS bus: hardware I2C #0 ──────────────────────────────────────────────────
static TwoWire WireHRS = TwoWire(0);
static const uint32_t kHrsI2cFreqHz = 400000;

MAX30101 hrSensor(0x57, WireHRS);

// ── HRS retry / recovery timing ──────────────────────────────────────────────
static const uint32_t kHrsRetryIntervalMs = 500;
static uint32_t g_hrsLastAttemptMs = 0;

// After this many consecutive failed HRS attempts, assume the bus may be
// wedged (SDA/SCL stuck low by a mid-transaction slave) and re-run recovery.
static const uint8_t kHrsRecoveryAfterFails = 3;
static uint8_t g_hrsConsecutiveFails = 0;

// ── 1.8 V rail PWM + feedback ────────────────────────────────────────────────
#define HRS_18V_LEDC_CHANNEL 0
#define HRS_18V_LEDC_RES_BITS 8

// Conservative max: assume worst-case 40 MHz effective LEDC clock source.
static const uint32_t kHrs18vFreqHz = 156250;

// The MAX30101 load pulls the rail down. Use the rail itself as feedback and
// regulate to ~1.90 V instead of open-looping at a fixed duty.
static const uint16_t kHrs18vTargetMv = 1900;
static const uint16_t kHrs18vMinMv = 1700;
static const uint16_t kHrs18vMaxMv = 2050;
static const uint8_t kHrs18vStartDuty = 150;
static const uint8_t kHrs18vMinDuty = 0;
static const uint8_t kHrs18vMaxDuty = 200;
static const uint32_t kHrs18vFeedbackIntervalMs = 20;
static uint32_t g_hrs18vLastFeedbackMs = 0;
static uint8_t g_hrs18vDuty = kHrs18vStartDuty;

static uint16_t hrs_18v_read_mv(void)
{
  // PIN_HRS_INT is tied to the HRS 1.8 V rail. Do not enable a digital
  // pull-up here; the pin must only observe the rail.
  return static_cast<uint16_t>(analogReadMilliVolts(PIN_HRS_INT));
}

static void hrs_18v_set_duty(uint8_t duty)
{
  g_hrs18vDuty = duty;
  ledcWrite(HRS_18V_LEDC_CHANNEL, g_hrs18vDuty);
}

static void hrs_18v_feedback(bool force_print = false)
{
  const uint32_t now = millis();
  if (!force_print && (now - g_hrs18vLastFeedbackMs < kHrs18vFeedbackIntervalMs))
  {
    return;
  }
  g_hrs18vLastFeedbackMs = now;

  const uint16_t mv = hrs_18v_read_mv();
  const int error_mv = static_cast<int>(kHrs18vTargetMv) - static_cast<int>(mv);

  // Proportional, bounded duty correction. With the original code the rail
  // settled around 1.7 V under load; this raises duty until the measured rail
  // reaches ~1.9 V and then keeps correcting for load changes.
  int step = error_mv / 25;
  if (step == 0 && abs(error_mv) >= 5)
  {
    step = (error_mv > 0) ? 1 : -1;
  }
  step = constrain(step, -8, 8);

  if (mv < kHrs18vMinMv || mv > kHrs18vMaxMv || step != 0)
  {
    int newDuty = static_cast<int>(g_hrs18vDuty) + step;
    newDuty = constrain(newDuty, static_cast<int>(kHrs18vMinDuty),
                        static_cast<int>(kHrs18vMaxDuty));
    if (newDuty != g_hrs18vDuty)
    {
      hrs_18v_set_duty(static_cast<uint8_t>(newDuty));
    }
  }

  Serial.printf("[HRS] rail: %umV  target: %umV  duty: %u\n",
                mv, kHrs18vTargetMv, g_hrs18vDuty);
}

static void hrs_18v_init(void)
{
  pinMode(PIN_LLS_EN, OUTPUT);
  digitalWrite(PIN_LLS_EN, HIGH);

  // GPIO12 is used only as an analog monitor because it is shorted to the
  // HRS 1.8 V rail. GPIO12 is ADC-capable on ESP32-S3.
  pinMode(PIN_HRS_INT, INPUT);
  analogSetPinAttenuation(PIN_HRS_INT, ADC_11db);

  if (ledcSetup(HRS_18V_LEDC_CHANNEL, kHrs18vFreqHz, HRS_18V_LEDC_RES_BITS) == 0)
  {
    Serial.println("[HRS] ledcSetup FAILED even at fallback frequency");
    return;
  }
  ledcAttachPin(PIN_HRS_18V, HRS_18V_LEDC_CHANNEL);

  // Start slightly above the old open-loop setting, then let measured rail
  // voltage determine the final duty.
  hrs_18v_set_duty(kHrs18vStartDuty);

  delay(10); // let the RC filter and MAX30101 supply settle

  // A few immediate feedback passes get the rail near target before I2C.
  for (uint8_t i = 0; i < 10; ++i)
  {
    hrs_18v_feedback(true);
    delay(kHrs18vFeedbackIntervalMs);
  }
}

// ── I2C bus recovery ─────────────────────────────────────────────────────────
static void i2c_bus_recovery(uint8_t sda_pin, uint8_t scl_pin)
{
  pinMode(scl_pin, OUTPUT_OPEN_DRAIN);
  pinMode(sda_pin, INPUT_PULLUP);

  if (digitalRead(sda_pin) == HIGH)
  {
    return; // bus already idle-high, nothing to recover
  }

  Serial.println("[I2C] SDA stuck low, attempting bus recovery...");

  for (int i = 0; i < 9; i++)
  {
    digitalWrite(scl_pin, LOW);
    delayMicroseconds(5);
    digitalWrite(scl_pin, HIGH);
    delayMicroseconds(5);
    if (digitalRead(sda_pin) == HIGH)
    {
      break;
    }
  }

  // Manual STOP: SDA low->high while SCL is held high.
  pinMode(sda_pin, OUTPUT_OPEN_DRAIN);
  digitalWrite(sda_pin, LOW);
  delayMicroseconds(5);
  digitalWrite(scl_pin, HIGH);
  delayMicroseconds(5);
  digitalWrite(sda_pin, HIGH);
  delayMicroseconds(5);

  Serial.printf("[I2C] recovery result: SDA=%d\n", digitalRead(sda_pin));
}

static bool i2c_probe(TwoWire &wire, uint8_t addr, const char *device_name)
{
  wire.beginTransmission(addr);
  uint8_t err = wire.endTransmission();
  if (err == 0)
  {
    Serial.printf("[I2C] %-12s found    at 0x%02X\n", device_name, addr);
    return true;
  }

  Serial.printf("[I2C] %-12s NOT found at 0x%02X (err %u)\n",
                device_name, addr, err);
  return false;
}

static void hrs_try_init(void)
{
  // Keep the rail regulated while the sensor is being probed/initialized.
  hrs_18v_feedback(true);

  g_hrs_ok = i2c_probe(WireHRS, 0x57, "MAX30101");
  if (g_hrs_ok)
  {
    g_hrs_ok = hrSensor.begin();
    Serial.printf("[HRS] init %s\n", g_hrs_ok ? "OK" : "FAILED");
  }

  if (g_hrs_ok)
  {
    g_hrsConsecutiveFails = 0;
  }
  else
  {
    g_hrsConsecutiveFails++;
  }
}

void setup()
{
  Serial.begin(115200);
  delay(200);

  hrs_18v_init();

  // Recover the HRS bus before Wire brings the pins up as I2C.
  i2c_bus_recovery(PIN_HRS_SDA, PIN_HRS_SCL);

  // Hardware I2C bus 0 for the HRS.
  WireHRS.begin(PIN_HRS_SDA, PIN_HRS_SCL, kHrsI2cFreqHz);

  // Initial attempt right away.
  hrs_try_init();
  g_hrsLastAttemptMs = millis();
}

void loop()
{
  const uint32_t now = millis();

  // Continuously monitor the rail so extra MAX30101 LED current does not
  // pull it back toward the old ~1.7 V level.
  hrs_18v_feedback(false);

  if (!g_hrs_ok && (now - g_hrsLastAttemptMs >= kHrsRetryIntervalMs))
  {
    g_hrsLastAttemptMs = now;

    if (g_hrsConsecutiveFails >= kHrsRecoveryAfterFails)
    {
      WireHRS.end();
      i2c_bus_recovery(PIN_HRS_SDA, PIN_HRS_SCL);
      WireHRS.begin(PIN_HRS_SDA, PIN_HRS_SCL, kHrsI2cFreqHz);
      g_hrsConsecutiveFails = 0;
    }

    hrs_try_init();
  }

  const uint16_t rail_mv = hrs_18v_read_mv();
  Serial.printf("[status] HRS: %s  rail: %umV  duty: %u\n",
                g_hrs_ok ? "OK" : "FAIL", rail_mv, g_hrs18vDuty);
  delay(50);
}
